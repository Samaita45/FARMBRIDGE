# Copy to server/.env and fill in. server/.env is gitignored — never commit it.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=farmbridge
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=farmbridge
# Host port only. Change if something already listens on 5432.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
DATABASE_URL=postgresql://farmbridge:change-me-locally@localhost:5433/farmbridge?schema=public

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-locally
REDIS_URL=redis://:change-me-locally@localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh secrets MUST differ, so a leaked access secret cannot mint
# refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── HTTP ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated. No wildcard: the mobile app sends credentials.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ─── Payments (Paynow) ───────────────────────────────────────────────────────
# Server-side only. These must never reach the mobile bundle.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=http://localhost:3000/v1/payments/webhook/paynow
PAYNOW_RETURN_URL=farmbridge://payments/return
# Leave as 'mock' until real credentials exist; 'paynow' switches the adapter.
PAYMENT_PROVIDER=mock
