# Copy to .env. Only EXPO_PUBLIC_* variables reach the app bundle — never put a
# secret here, because anything in this file ships to every device.

# Leave false to run fully on-device (SQLite + local accounts). This is the
# default so a fresh checkout works with no backend running.
EXPO_PUBLIC_API_ENABLED=false

# The API from server/. Android emulators cannot reach the host's localhost, so
# 10.0.2.2 is used automatically in development; a physical phone needs your
# machine's LAN address, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# The tenant this build belongs to. Printed by `npx prisma db seed` in server/.
EXPO_PUBLIC_TENANT_ID=

# Support contact shown in-app. Digits only, no leading +.
EXPO_PUBLIC_SUPPORT_PHONE=

# Google Maps SDK keys — build-time only, never EXPO_PUBLIC_*. Restrict each
# key in Google Cloud to this app's package / bundle: co.zw.farmbridge
# Android: Maps SDK for Android + SHA-1 of the signing cert.
# iOS: Maps SDK for iOS + bundle identifier.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Optional fallback used by app.config.js when the platform keys are empty.
GOOGLE_MAPS_API_KEY=
